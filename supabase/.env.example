# Supabase Edge Function secrets (server-side only — never use VITE_ prefix)
# Copy to supabase/.env for local `supabase functions serve`, or set via:
#   npx supabase secrets set KEY=value

# UK address lookup (uk-address-lookup function)
POSTCODES_IO_URL=https://api.postcodes.io
NOMINATIM_URL=https://nominatim.openstreetmap.org/search
GETADDRESS_BASE_URL=https://api.getAddress.io
GETADDRESS_API_KEY=
