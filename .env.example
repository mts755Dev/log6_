# Frontend (Vite) — required
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Do NOT put service role in frontend builds for production.
# VITE_SUPABASE_SERVICE_ROLE_KEY=

# OpenRouter (primary — pushed to Supabase Edge secrets via scripts/push-assistant-secrets.mjs)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_key
OPENAI_API_BASE_URL=https://openrouter.ai/api/v1
OPENAI_MODEL=openai/gpt-4o-mini
LLM_PROVIDER=openrouter
AI_EMBEDDING_MODEL=openai/text-embedding-3-small

# Pinecone (push to Supabase secrets, not used by Vite)
PINECONE_API_KEY=your_pinecone_key
PINECONE_HOST=your-index.svc.region.pinecone.io

# Optional
VITE_STRIPE_PUBLISHABLE_KEY=
